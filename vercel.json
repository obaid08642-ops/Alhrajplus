{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd frontend && yarn install --frozen-lockfile && yarn build",
  "outputDirectory": "frontend/build",
  "installCommand": "echo 'Using monorepo install via buildCommand'",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://alhrajplus.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://alhrajplus.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://alhrajplus.onrender.com/robots.txt"
    },
    {
      "source": "/((?!api|sitemap|robots|favicon|logo|assets|static).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff|woff2|ttf|png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
