{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd frontend && yarn install --frozen-lockfile && CI=false GENERATE_SOURCEMAP=false yarn build",
  "outputDirectory": "frontend/build",
  "installCommand": "echo 'skip-root-install'",
  "framework": null,
  "rewrites": [
    { "source": "/.well-known/assetlinks.json", "destination": "https://alhrajplus.onrender.com/.well-known/assetlinks.json" },
    { "source": "/.well-known/apple-app-site-association", "destination": "https://alhrajplus.onrender.com/.well-known/apple-app-site-association" },
    { "source": "/api/:path*", "destination": "https://alhrajplus.onrender.com/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://alhrajplus.onrender.com/sitemap.xml" },
    { "source": "/robots.txt",  "destination": "https://alhrajplus.onrender.com/robots.txt" },
    { "source": "/listing/:path*", "destination": "https://alhrajplus.onrender.com/listing/:path*" },
    { "source": "/:key([a-f0-9]{16,128}).txt", "destination": "https://alhrajplus.onrender.com/:key.txt" },
    { "source": "/((?!api|sitemap|robots|favicon|logo|assets|static).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff|woff2|ttf|png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
