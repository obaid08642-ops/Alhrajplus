{
  "expo": {
    "name": "الحراج بلس",
    "slug": "haraj-plus",
    "owner": "harajplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "harajplus",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1A35"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harajplus.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:alhraj.online",
        "applinks:alhrajplus.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم التطبيق موقعك لعرض الإعلانات القريبة منك",
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لإضافة صور للإعلانات",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق مكتبة الصور لإضافة صور للإعلانات",
        "NSMicrophoneUsageDescription": "يستخدم التطبيق الميكروفون لتسجيل الرسائل الصوتية في الشات",
        "NSFaceIDUsageDescription": "يستخدم التطبيق Face ID لتسجيل الدخول الآمن",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.harajplus.app",
            "CFBundleURLSchemes": [
              "harajplus"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.harajplus.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4FB6E6"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "harajplus",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "alhraj.online"
            },
            {
              "scheme": "https",
              "host": "alhrajplus.com"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق إذنك للوصول إلى الصور لرفع إعلاناتك",
          "cameraPermission": "يحتاج التطبيق إذنك لاستخدام الكاميرا لإضافة صور للإعلانات"
        }
      ],
      "expo-audio",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "backendUrl": "https://alhrajplus.onrender.com",
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
